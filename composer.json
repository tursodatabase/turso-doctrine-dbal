{
    "name": "tursodatabase/turso-doctrine-dbal",
    "description": "A Doctrine DBAL driver for libSQL (Turso) built on the native LibSQL PHP extension",
    "type": "library",
    "version": "1.3.0",
    "require": {
        "php": "^8.2",
        "doctrine/dbal": "^4.0"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Turso\\Doctrine\\DBAL\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Imam Ali Mustofa",
            "email": "darkterminal@duck.com",
            "role": "Software Freestyle Engineer"
        }
    ],
    "keywords": [
        "doctrine",
        "dbal",
        "libsql",
        "turso",
        "sqlite"
    ],
    "homepage": "https://github.com/tursodatabase/turso-doctrine-dbal",
    "require-dev": {
        "phpunit/phpunit": "^11"
    },
    "autoload-dev": {
        "psr-4": {
            "Turso\\Doctrine\\DBAL\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
